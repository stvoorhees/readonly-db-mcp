<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup Label="NuGet packaging">
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>readonly-db-mcp</ToolCommandName>
    <PackageType>McpServer</PackageType>
    <PackageId>ReadOnlyDbMcp</PackageId>
    <Version>0.1.0</Version>
    <Authors>Spencer Voorhees</Authors>
    <Description>Read-only database MCP server. Agents never submit SQL — they call structured tools (list_tables, describe_table, read_rows, count_rows) and the server authors every statement. Supports SQL Server, PostgreSQL, and MySQL/MariaDB.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/stvoorhees/readonly-db-mcp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/stvoorhees/readonly-db-mcp</RepositoryUrl>
    <PackageTags>mcp;mcp-server;database;sqlserver;postgres;mysql;readonly;ai;agent</PackageTags>
  </PropertyGroup>

  <ItemGroup Label="NuGet packaging">
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include=".mcp/server.json" Pack="true" PackagePath="/.mcp/" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.10" />
    <PackageReference Include="ModelContextProtocol" Version="2.0.0" />
    <PackageReference Include="MySqlConnector" Version="2.6.1" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
  </ItemGroup>

</Project>
